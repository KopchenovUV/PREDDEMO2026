<Window x:Class="DataValidator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Валидация данных клиентов" Height="450" Width="550"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <GroupBox Header="Данные клиента" Grid.Row="0" Margin="5">
            <StackPanel Margin="5">
                <TextBlock Text="ФИО:" FontWeight="Bold"/>
                <TextBox x:Name="txtFIO" Height="30" Margin="0,5,0,10" IsReadOnly="True" Background="#F0F0F0"/>
                <Button x:Name="btnGetData" Content="Получить данные" Click="BtnGetData_Click" 
                        Height="35" Background="LightBlue" FontSize="14"/>
            </StackPanel>
        </GroupBox>

        <GroupBox Header="Результат валидации" Grid.Row="1" Margin="5">
            <StackPanel Margin="5">
                <TextBlock x:Name="txtResult" TextWrapping="Wrap" MinHeight="60" FontSize="13"/>
                <Button x:Name="btnSendResult" Content="Отправить результат теста" 
                        Click="BtnSendResult_Click" Height="35" Margin="0,10,0,0" 
                        Background="LightGreen" IsEnabled="False" FontSize="14"/>
            </StackPanel>
        </GroupBox>

        <TextBlock Grid.Row="2" Text="Критерии проверки:" FontWeight="Bold" Margin="5,10,0,0"/>
        <ListBox Grid.Row="3" Margin="5" Height="90">
            <ListBoxItem Content="1. ФИО не должно содержать цифры (0-9)"/>
            <ListBoxItem Content="2. ФИО не должно содержать спецсимволы (!@#$%^&amp;*()_+{}[]|;:'&quot;&lt;&gt;?,./)"/>
        </ListBox>

        <StatusBar Grid.Row="4" VerticalAlignment="Bottom" Margin="5">
            <StatusBarItem>
                <TextBlock x:Name="txtStatus" Text="Готов к работе" Foreground="Gray"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>