<Window x:Class="Zanovo.Views.AddEditUserDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Пользователь" 
        Height="450" Width="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Логин -->
        <StackPanel Grid.Row="0" Margin="0,5">
            <TextBlock Text="Логин:" FontSize="14" Margin="0,0,0,5"/>
            <TextBox x:Name="txtLogin" Height="30" FontSize="14" Padding="5"/>
        </StackPanel>

        <!-- Пароль -->
        <StackPanel Grid.Row="1" Margin="0,5">
            <TextBlock Text="Пароль:" FontSize="14" Margin="0,0,0,5"/>
            <PasswordBox x:Name="txtPassword" Height="30" FontSize="14" Padding="5"/>
            <CheckBox x:Name="chkChangePassword" Content="Изменить пароль" 
                      Margin="0,5,0,0" Visibility="Collapsed"/>
        </StackPanel>

        <!-- Роль -->
        <StackPanel Grid.Row="2" Margin="0,5">
            <TextBlock Text="Роль:" FontSize="14" Margin="0,0,0,5"/>
            <ComboBox x:Name="cmbRole" Height="30" FontSize="14"
                      DisplayMemberPath="Name" SelectedValuePath="ID_Role"/>
        </StackPanel>

        <!-- Блокировка (только для редактирования) -->
        <StackPanel Grid.Row="3" Margin="0,5" x:Name="panelBlocked">
            <CheckBox x:Name="chkIsBlocked" Content="Пользователь заблокирован" 
                      FontSize="14" Margin="0,10,0,0"/>
        </StackPanel>

        <!-- Кнопки -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" 
                    HorizontalAlignment="Center" Margin="0,20,0,0">
            <Button x:Name="btnSave" Content="Сохранить" Click="BtnSave_Click" 
                    Width="100" Height="35" Margin="5"
                    Background="#4CAF50" Foreground="White" Cursor="Hand"/>
            <Button x:Name="btnCancel" Content="Отмена" Click="BtnCancel_Click" 
                    Width="100" Height="35" Margin="5"
                    Background="#9E9E9E" Foreground="White" Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Window>