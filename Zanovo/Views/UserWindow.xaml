<Window x:Class="Zanovo.Views.UserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Пользовательская панель" 
        Height="400" Width="600"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Добро пожаловать в систему!" 
                   FontSize="24" FontWeight="Bold" 
                   HorizontalAlignment="Center" Margin="0,0,0,20"/>

        <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock x:Name="tbWelcome" FontSize="16" TextAlignment="Center"/>
        </StackPanel>

        <!-- Кнопка выхода -->
        <Button x:Name="btnLogout" Grid.Row="2" Content="🚪 Выйти из системы" 
                Click="BtnLogout_Click" 
                Height="40" Width="150" Margin="0,15,0,10"
                HorizontalAlignment="Right"
                Background="#9E9E9E" Foreground="White" Cursor="Hand"/>
    </Grid>
</Window>